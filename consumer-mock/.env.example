# This program reads exported environment variables, not .env automatically.
# See README.md for loading this file before running locally.
KAFKA_BROKERS=localhost:9092

# Request topic from the server relay.
KAFKA_TOPIC=anomaly.bank.events.v1
KAFKA_CONSUMER_GROUP=model-pipeline

# Response topic; must match the server's KAFKA_RISK_DECISION_TOPIC.
KAFKA_OUTPUT_TOPIC=anomaly.bank.risk-decisions.v1

# Fixed decision for every request: PENDING, ALLOW, or BLOCK (not random).
# PENDING does not automatically transition to a terminal decision.
MOCK_RISK_DECISION=ALLOW
MOCK_MODEL_VERSION=mock-v1
