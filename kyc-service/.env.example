APP_NAME=Anomaly Python Service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8090
VISION_PIPELINE_BACKEND=disabled
ALLOW_STUB_VISION_PIPELINE=false
# For real mode, install .[vision], mount your own model assets and calibrate vision.toml.
KYC_SERVICE_TOKEN=
VISION_CONFIG_PATH=config/vision.example.toml
FACE_MODEL_MANIFEST_PATH=/models/manifest.json
MATCH_THRESHOLD=0.78
LIVENESS_THRESHOLD=0.85
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=26214400
MIN_VIDEO_DURATION_SECONDS=3
DEFAULT_CHALLENGE_TYPE=TURN_HEAD_LEFT_RIGHT_BLINK
