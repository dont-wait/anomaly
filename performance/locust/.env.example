# API server used by Locust.
LOCUST_HOST=http://localhost:8080

# A verified customer account with enough balance for repeated test transfers.
LOCUST_CUSTOMER_CCCD=replace-with-customer-cccd
LOCUST_CUSTOMER_PASSWORD=replace-with-customer-password
LOCUST_DESTINATION_ACCOUNT=replace-with-active-destination-account

# An administrator account for monitor, SSE and audit APIs.
LOCUST_ADMIN_CCCD=replace-with-admin-cccd
LOCUST_ADMIN_PASSWORD=replace-with-admin-password
LOCUST_AUDIT_ACCOUNT_ID=replace-with-account-id

# Optional test tuning.
LOCUST_TRANSFER_AMOUNT=1000
LOCUST_TRANSFER_BANK_CODE=ANOMALY
LOCUST_ALERT_POLL_INTERVAL=0.5
LOCUST_ALERT_TIMEOUT=30
LOCUST_AUDIT_FROM=2026-01-01
LOCUST_AUDIT_TO=2030-01-01
LOCUST_AUDIT_LIMIT=20
LOCUST_CONFIRM_WITHOUT_OTP=true
