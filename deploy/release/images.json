{
  "schemaVersion": 1,
  "images": [
    {
      "name": "server",
      "repository": "anomaly-server",
      "context": "server",
      "dockerfile": "server/Dockerfile",
      "checksTarget": "checks",
      "imageVariable": "SERVER_IMAGE",
      "testCommand": [
        "go",
        "test",
        "-count=1",
        "./..."
      ]
    },
    {
      "name": "kyc",
      "repository": "anomaly-kyc",
      "context": "kyc-service",
      "dockerfile": "kyc-service/Dockerfile",
      "checksTarget": "checks",
      "imageVariable": "KYC_IMAGE"
    },
    {
      "name": "ml",
      "repository": "anomaly-ml",
      "context": "anomaly-service",
      "dockerfile": "anomaly-service/Dockerfile",
      "checksTarget": "checks",
      "imageVariable": "ML_SERVICE_IMAGE",
      "additionalContext": "gatv2"
    },
    {
      "name": "autoscaler",
      "repository": "anomaly-ml-autoscaler",
      "context": "deploy/swarm/autoscaler",
      "dockerfile": "deploy/swarm/autoscaler/Dockerfile",
      "checksTarget": "checks",
      "imageVariable": "ML_AUTOSCALER_IMAGE"
    }
  ]
}
