# Copy outside the repository, chmod 600, and fill real values.
# Pass this file FIRST, then generated images.env via --env-file.
MONGO_ROOT_USERNAME=anomaly
MONGO_ROOT_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_EXPIRY=24h
KAFKA_RISK_DECISION_SIGNING_KEY=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# Require a tested version/digest instead of implicitly upgrading latest.
RUSTFS_IMAGE=
KYC_MODEL_DIR=/opt/anomaly/shared/models/kyc
KYC_SERVICE_TOKEN=
VISION_PIPELINE_BACKEND=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
TRUSTED_PROXY_CIDRS=
# Compose infrastructure is localhost-only by default. Remote Swarm workers need
# deliberately configured reachable listeners/firewall/TLS; localhost won't work.
KAFKA_ADVERTISED_HOST=localhost
ML_KAFKA_BROKERS=
ML_KAFKA_EXPORTER_SERVER=
ML_EVENTSTORE_URI=
ML_MIN_REPLICAS=1
ML_MAX_REPLICAS=4
