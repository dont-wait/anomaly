{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anomaly Admin Console",
  "version": "0.1.0",
  "identifier": "com.dontwait.anomaly.admin",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Anomaly Admin Console",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
