[
  {
    "update": "accounts",
    "updates": [
      {
        "q": { "role": { "$exists": false } },
        "u": { "$set": { "role": "user" } },
        "multi": true
      }
    ]
  },
  {
    "collMod": "accounts",
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["_id", "account_no", "customer_id", "username", "email", "password_hash", "type", "role", "currency", "balance", "status", "version", "opened_at", "created_at", "updated_at"],
        "properties": {
          "_id": { "bsonType": ["objectId", "string"] },
          "account_no": { "bsonType": "string" },
          "customer_id": { "bsonType": "objectId" },
          "username": { "bsonType": "string" },
          "email": { "bsonType": "string" },
          "password_hash": { "bsonType": "string" },
          "type": { "enum": ["payment"] },
          "role": { "enum": ["user", "admin"] },
          "currency": { "enum": ["VND"] },
          "balance": {
            "bsonType": "object",
            "required": ["current"],
            "properties": { "current": { "bsonType": "long" } }
          },
          "status": { "enum": ["active"] },
          "version": { "bsonType": "long", "minimum": 0 },
          "opened_at": { "bsonType": "date" },
          "created_at": { "bsonType": "date" },
          "updated_at": { "bsonType": "date" }
        }
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  }
]
