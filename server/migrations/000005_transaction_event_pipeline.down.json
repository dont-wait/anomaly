[
  {
    "dropIndexes": "ledger_entries",
    "index": "uniq_ledger_transaction_direction"
  },
  {
    "dropIndexes": "accounts",
    "index": "uniq_account_financial_id"
  },
  {
    "collMod": "accounts",
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "_id",
          "account_no",
          "customer_id",
          "username",
          "email",
          "password_hash",
          "type",
          "currency",
          "balance",
          "status",
          "version",
          "opened_at",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "_id": {
            "bsonType": [
              "objectId",
              "string"
            ]
          },
          "account_no": {
            "bsonType": "string"
          },
          "customer_id": {
            "bsonType": "objectId"
          },
          "username": {
            "bsonType": "string"
          },
          "email": {
            "bsonType": "string"
          },
          "password_hash": {
            "bsonType": "string"
          },
          "type": {
            "enum": [
              "payment"
            ]
          },
          "currency": {
            "enum": [
              "VND"
            ]
          },
          "balance": {
            "bsonType": "object",
            "required": [
              "current"
            ],
            "properties": {
              "current": {
                "bsonType": "long"
              }
            }
          },
          "status": {
            "enum": [
              "active"
            ]
          },
          "version": {
            "bsonType": "long",
            "minimum": 0
          },
          "opened_at": {
            "bsonType": "date"
          },
          "created_at": {
            "bsonType": "date"
          },
          "updated_at": {
            "bsonType": "date"
          }
        }
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  }
]
