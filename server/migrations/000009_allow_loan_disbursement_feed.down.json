
[
  {
    "collMod": "account_transaction_feed",
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "account_id",
          "transaction_id",
          "direction",
          "type",
          "counterparty",
          "amount",
          "fee",
          "status",
          "note",
          "reference",
          "search_text",
          "occurred_at"
        ],
        "properties": {
          "account_id": {
            "bsonType": "objectId"
          },
          "transaction_id": {
            "bsonType": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "direction": {
            "enum": ["IN", "OUT"]
          },
          "type": {
            "enum": [
              "transfer",
              "payment",
              "bill",
              "topup",
              "savings",
              "salary"
            ]
          },
          "counterparty": {
            "bsonType": "object",
            "required": ["account_no", "name"],
            "properties": {
              "account_no": {
                "bsonType": "string"
              },
              "name": {
                "bsonType": "string"
              },
              "bank_code": {
                "bsonType": ["string", "null"]
              }
            }
          },
          "amount": {
            "bsonType": "long",
            "minimum": 1
          },
          "fee": {
            "bsonType": "long",
            "minimum": 0
          },
          "balance_after": {
            "bsonType": ["long", "null"],
            "minimum": 0
          },
          "status": {
            "enum": [
              "awaiting_otp",
              "pending",
              "success",
              "failed",
              "cancelled"
            ]
          },
          "note": {
            "bsonType": "string",
            "maxLength": 100
          },
          "reference": {
            "bsonType": "string"
          },
          "search_text": {
            "bsonType": "string"
          },
          "occurred_at": {
            "bsonType": "date"
          }
        }
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  }
]
