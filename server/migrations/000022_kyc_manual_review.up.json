[
  {
    "createIndexes": "kyc_sessions",
    "indexes": [
      {
        "key": { "status": 1, "created_at": -1 },
        "name": "idx_status_created_at"
      }
    ]
  },
  {
    "collMod": "customers",
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["_id", "customer_code", "profile", "identity", "verified_kyc_session_id", "kyc_status", "credit_profile", "status", "created_at", "updated_at"],
        "properties": {
          "_id": { "bsonType": "objectId" },
          "customer_code": { "bsonType": "string" },
          "profile": {
            "bsonType": "object",
            "required": ["full_name", "date_of_birth", "phone", "email", "address"],
            "properties": {
              "full_name": { "bsonType": "string" },
              "date_of_birth": { "bsonType": ["date", "null"] },
              "phone": { "bsonType": ["string", "null"] },
              "email": { "bsonType": "string" },
              "address": {
                "bsonType": "object",
                "required": ["line", "province_code"],
                "properties": {
                  "line": { "bsonType": "string" },
                  "province_code": { "bsonType": "string" }
                }
              }
            }
          },
          "identity": {
            "bsonType": "object",
            "required": ["type", "number", "issued_date", "issued_place", "permanent_address"],
            "properties": {
              "type": { "bsonType": ["string", "null"] },
              "number": { "bsonType": ["string", "null"] },
              "issued_date": { "bsonType": ["date", "null"] },
              "issued_place": { "bsonType": ["string", "null"] },
              "permanent_address": { "bsonType": ["string", "null"] }
            }
          },
          "verified_kyc_session_id": { "bsonType": ["objectId", "null"] },
          "kyc_status": { "enum": ["not_started", "pending", "verified", "rejected"] },
          "credit_profile": {
            "bsonType": "object",
            "required": ["score", "bad_debt", "updated_at"],
            "properties": {
              "score": { "bsonType": ["int", "long"] },
              "bad_debt": { "bsonType": "bool" },
              "updated_at": { "bsonType": "date" }
            }
          },
          "status": { "enum": ["active"] },
          "created_at": { "bsonType": "date" },
          "updated_at": { "bsonType": "date" }
        }
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  },
  {
    "collMod": "kyc_sessions",
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["_id", "customer_id", "attempt_no", "status", "identity_data", "media", "verification", "failure", "started_at", "completed_at", "created_at"],
        "properties": {
          "_id": { "bsonType": "objectId" },
          "customer_id": { "bsonType": "objectId" },
          "attempt_no": { "bsonType": ["int", "long"], "minimum": 1 },
          "status": { "enum": ["pending", "verified", "rejected"] },
          "identity_data": {
            "bsonType": "object",
            "required": ["type", "number", "full_name", "date_of_birth", "issued_date", "issued_place", "permanent_address"],
            "properties": {
              "type": { "bsonType": ["string", "null"] },
              "number": { "bsonType": ["string", "null"] },
              "full_name": { "bsonType": ["string", "null"] },
              "date_of_birth": { "bsonType": ["date", "null"] },
              "issued_date": { "bsonType": ["date", "null"] },
              "issued_place": { "bsonType": ["string", "null"] },
              "permanent_address": { "bsonType": ["string", "null"] }
            }
          },
          "media": {
            "bsonType": "object",
            "required": ["identity_front", "identity_back", "liveness_video"],
            "properties": {
              "identity_front": {
                "bsonType": "object",
                "required": ["storage_key", "mime_type", "size_bytes", "sha256"],
                "properties": {
                  "storage_key": { "bsonType": "string" },
                  "mime_type": { "bsonType": ["string", "null"] },
                  "size_bytes": { "bsonType": ["long", "null"] },
                  "sha256": { "bsonType": ["string", "null"] }
                }
              },
              "identity_back": {
                "bsonType": "object",
                "required": ["storage_key", "mime_type", "size_bytes", "sha256"],
                "properties": {
                  "storage_key": { "bsonType": "string" },
                  "mime_type": { "bsonType": ["string", "null"] },
                  "size_bytes": { "bsonType": ["long", "null"] },
                  "sha256": { "bsonType": ["string", "null"] }
                }
              },
              "face_image": {
                "bsonType": "object",
                "required": ["storage_key", "mime_type", "size_bytes", "sha256"],
                "properties": {
                  "storage_key": { "bsonType": "string" },
                  "mime_type": { "bsonType": ["string", "null"] },
                  "size_bytes": { "bsonType": ["long", "null"] },
                  "sha256": { "bsonType": ["string", "null"] }
                }
              },
              "liveness_video": {
                "bsonType": "object",
                "required": ["storage_key", "mime_type", "size_bytes", "sha256", "duration_seconds"],
                "properties": {
                  "storage_key": { "bsonType": "string" },
                  "mime_type": { "bsonType": ["string", "null"] },
                  "size_bytes": { "bsonType": ["long", "null"] },
                  "sha256": { "bsonType": ["string", "null"] },
                  "duration_seconds": { "bsonType": ["int", "long", "null"] }
                }
              }
            }
          },
          "verification": {
            "bsonType": "object",
            "required": ["ocr_status", "liveness_status", "face_match_status", "face_match_score", "provider", "provider_reference_id"],
            "properties": {
              "ocr_status": { "enum": ["not_run", "passed", "failed"] },
              "liveness_status": { "enum": ["not_run", "passed", "failed"] },
              "face_match_status": { "enum": ["not_run", "passed", "failed"] },
              "face_match_score": { "bsonType": ["decimal", "null"] },
              "provider": { "bsonType": ["string", "null"] },
              "provider_reference_id": { "bsonType": ["string", "null"] },
              "liveness_score": { "bsonType": "double", "minimum": 0, "maximum": 1 },
              "evidence": { "bsonType": ["object", "null"] }
            }
          },
          "review": {
            "bsonType": "object",
            "required": ["decision", "reason", "reviewed_by", "reviewed_at"],
            "properties": {
              "decision": { "enum": ["APPROVED", "REJECTED"] },
              "reason": { "bsonType": "string" },
              "reviewed_by": { "bsonType": "string" },
              "reviewed_at": { "bsonType": "date" }
            }
          },
          "failure": {
            "bsonType": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "bsonType": ["string", "null"] },
              "message": { "bsonType": ["string", "null"] }
            }
          },
          "started_at": { "bsonType": "date" },
          "completed_at": { "bsonType": ["date", "null"] },
          "created_at": { "bsonType": "date" }
        }
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  }
]
