MONGO_URI=mongodb://username:password@localhost:27017/?authSource=admin&replicaSet=rs0
MONGO_DB=anomaly
MONGO_ROOT_USERNAME=username
MONGO_ROOT_PASSWORD=password
CORS_ALLOWED_ORIGINS="http://localhost:1420,http://localhost:1422,http://localhost:5173,http://localhost:3000,tauri://localhost,http://tauri.localhost"
# Comma-separated CIDRs of reverse proxies allowed to provide X-Real-IP.
# Leave empty for direct/local connections.
TRUSTED_PROXY_CIDRS=
# JWT_SECRET: required, must be at least 32 characters (HS256 HMAC key).
# In production, generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY=24h

# Swagger UI and OpenAPI spec are disabled by default.
SWAGGER_ENABLED=false

# Demo seed is disabled unless explicitly opted in for a local/development environment.
SEED_DEMO_ENABLED=false
ANOMALY_DEMO_ADMIN_PASSWORD=your-password-secret
# Demo account data: internal/seeder/xxx.go

RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=your_rustfs_access_key
RUSTFS_SECRET_KEY=your_rustfs_secret_key
RUSTFS_BUCKET=media
RUSTFS_REGION=us-east-1

# Python KYC verification service.
KYC_SERVICE_URL=http://localhost:8090
KYC_SERVICE_TOKEN=
# Accept explicitly marked demo results from the POC KYC service.
KYC_POC_BYPASS=false
KYC_MAX_ATTEMPTS=3
KYC_ATTEMPT_WINDOW=24h
KYC_ATTEMPT_TTL=2m
KYC_MAX_CONCURRENT_ATTEMPTS=8
KYC_STARTS_PER_MINUTE=6

# Redis (OTP store): host:port của Redis.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# SMTP (gửi OTP qua mail). Để trống SMTP_HOST = chưa cấu hình,
# API sẽ fail-closed (POST /api/auth/otp/request trả 500).
SMTP_HOST=
SMTP_PORT=587
# starttls (default, port 587) or implicit (port 465); certificates are verified.
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Canonical banking event store (required by API, seed and workers).
EVENT_STORE_CONN_STRING=esdb://localhost:2113?tls=false

# Kafka requests: relay publishes TransferCreated for model risk evaluation.
KAFKA_BROKERS=localhost:9092
# Optional host/IP advertised by Kafka to local development clients.
# dev-up.sh detects the current machine automatically when this is empty.
KAFKA_ADVERTISED_HOST=
KAFKA_TOPIC=anomaly.bank.events.v1
KAFKA_PRODUCER_ID=anomaly-server
KAFKA_EVENTSTORE_SUBSCRIPTION=kafka-publisher

# Kafka model responses: must match consumer-mock's KAFKA_OUTPUT_TOPIC.
# The scoring payload is stored in risk_decisions and powers the admin dashboard.
KAFKA_RISK_DECISION_TOPIC=anomaly.bank.risk-decisions.v1
KAFKA_RISK_DECISION_GROUP=anomaly-server-risk-decisions
# Shared HMAC-SHA256 key for model-response.v1 payloads and server verification.
# Use the same value in consumer-mock and the model service.
# Generate with: openssl rand -hex 32
KAFKA_RISK_DECISION_SIGNING_KEY=replace-with-the-server-shared-key
